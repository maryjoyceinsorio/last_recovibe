rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentAdminProfile() {
      let profilePath = /databases/$(database)/documents/adminUser/$(request.auth.uid);
      return exists(profilePath) ? get(profilePath).data : {};
    }

    function normalizeAccessKey(value) {
      return value is string ? value.lower().replace(" ", "").replace("_", "").replace("-", "").replace(".", "") : "";
    }

    function profileHasRole(profile, acceptedRoles) {
      let role = normalizeAccessKey(profile.get("role", ""));
      let userRole = normalizeAccessKey(profile.get("userRole", ""));
      let roles = profile.get("roles", []);
      return role in acceptedRoles
        || userRole in acceptedRoles
        || (roles is list && roles.hasAny(acceptedRoles));
    }

    function normalizeOrganizationCode(value) {
      return value is string ? value.lower() : "";
    }

    function eventHasOrganizationCode(eventData) {
      return eventData.get("organizationCode", "") != ""
        || eventData.get("organizerOrganization", "") != ""
        || eventData.get("orgCode", "") != ""
        || eventData.get("orgId", "") != ""
        || eventData.get("organization", "") != ""
        || eventData.get("organizerOrg", "") != "";
    }

    function eventOrganizationCodesMatch(eventData, organization) {
      let normalizedOrganization = normalizeOrganizationCode(organization);
      let organizationCode = normalizeOrganizationCode(eventData.get("organizationCode", ""));
      let organizerOrganization = normalizeOrganizationCode(eventData.get("organizerOrganization", ""));
      let orgCode = normalizeOrganizationCode(eventData.get("orgCode", ""));
      let orgId = normalizeOrganizationCode(eventData.get("orgId", ""));
      let organizationValue = normalizeOrganizationCode(eventData.get("organization", ""));
      let organizerOrg = normalizeOrganizationCode(eventData.get("organizerOrg", ""));
      let organizationCodesMatch =
        (eventData.get("organizationCode", "") == "" || organizationCode == normalizedOrganization)
        && (eventData.get("organizerOrganization", "") == "" || organizerOrganization == normalizedOrganization)
        && (eventData.get("orgCode", "") == "" || orgCode == normalizedOrganization)
        && (eventData.get("orgId", "") == "" || orgId == normalizedOrganization)
        && (eventData.get("organization", "") == "" || organizationValue == normalizedOrganization)
        && (eventData.get("organizerOrg", "") == "" || organizerOrg == normalizedOrganization);
      return normalizedOrganization != ""
        && eventHasOrganizationCode(eventData)
        && organizationCodesMatch
        && (
          organizationCode == normalizedOrganization
          || organizerOrganization == normalizedOrganization
          || orgCode == normalizedOrganization
          || orgId == normalizedOrganization
          || organizationValue == normalizedOrganization
          || organizerOrg == normalizedOrganization
        );
    }

    function eventOrganizationNamesMatch(eventData, organization) {
      let normalizedOrganization = normalizeOrganizationCode(organization);
      let organizationName = normalizeOrganizationCode(eventData.get("organizationName", ""));
      let orgName = normalizeOrganizationCode(eventData.get("orgName", ""));
      return normalizedOrganization != ""
        && (eventData.get("organizationName", "") == "" || organizationName == normalizedOrganization)
        && (eventData.get("orgName", "") == "" || orgName == normalizedOrganization)
        && (organizationName == normalizedOrganization || orgName == normalizedOrganization);
    }

    function eventOrganizationMatches(eventData, organization) {
      return eventOrganizationCodesMatch(eventData, organization)
        || (!eventHasOrganizationCode(eventData)
          && eventOrganizationNamesMatch(eventData, organization));
    }

    function eventHasOrganization(eventData) {
      return eventData.get("organizationCode", "") != ""
        || eventData.get("organizerOrganization", "") != ""
        || eventData.get("organization", "") != ""
        || eventData.get("organizationName", "") != ""
        || eventData.get("orgName", "") != ""
        || eventData.get("orgCode", "") != ""
        || eventData.get("orgId", "") != ""
        || eventData.get("organizerOrg", "") != "";
    }

    function isAdminAccount() {
      let profile = currentAdminProfile();
      let status = normalizeAccessKey(profile.get("status", "Active"));
      return profileHasRole(profile, ["admin", "superadmin", "Admin", "Super Admin"])
        && !(status in ["disabled", "inactive", "suspended"]);
    }

    function isSuperAdminAccount() {
      let profile = currentAdminProfile();
      return (isAdminAccount()
        && profileHasRole(profile, ["superadmin", "Super Admin"]))
        || (signedIn() && request.auth.token.get("email", "") == "marv@gmail.com");
    }

    function isOsasAccount() {
      let profile = currentAdminProfile();
      let osasMarker = profileHasRole(profile, ["osas", "OSAS"])
        || normalizeAccessKey(profile.get("roleSuffix", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approverRole", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approver_role", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("position", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("title", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("role_title", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("adminId", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("admin_id", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("accountNumber", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("accountNo", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("account_number", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("account_no", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approverId", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approver_id", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("employeeId", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("employee_id", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approvalStage", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approvalStageKey", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("assignedApprovalStage", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approverStage", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approverKey", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("approvalRole", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("assignedRole", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("assignedApprover", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("adminRole", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("roleName", "")).matches(".*osas.*")
        || normalizeAccessKey(profile.get("stageKey", "")).matches(".*osas.*");
      let status = normalizeAccessKey(profile.get("status", "Active"));
      return (profileHasRole(profile, ["osas", "OSAS"])
          || (profileHasRole(profile, ["admin", "superadmin", "Admin", "Super Admin"]) && osasMarker))
        && !(status in ["disabled", "inactive", "suspended"]);
    }

    function isOrganizationAdviser() {
      let organizationPath = /databases/$(database)/documents/approverOrganizations/$(request.auth.uid);
      let organizationCode = exists(organizationPath)
        ? get(organizationPath).data.get("organizationCode", "")
        : "";
      return isAdminAccount()
        && organizationCode != ""
        && organizationCode != "*";
    }

    function adviserOrganizationMatches(eventData) {
      let adviserPath = /databases/$(database)/documents/approverOrganizations/$(request.auth.uid);
      let organization = exists(adviserPath)
        ? get(adviserPath).data.get("organizationCode", "")
        : "";
      let creatorUid = eventData.get(
        "organizerUid",
        eventData.get("organizerId", eventData.get("createdBy", "__missing__"))
      );
      let creatorOrganizationPath = /databases/$(database)/documents/eventOrganizations/$(creatorUid);
      let creatorProfilePath = /databases/$(database)/documents/adminUser/$(creatorUid);
      let creatorProfile = exists(creatorProfilePath) ? get(creatorProfilePath).data : {};
      let creatorOrganization = creatorProfile.get(
        "organizationCode",
        creatorProfile.get("orgCode", creatorProfile.get("organization", ""))
      );
      let verifiedCreatorOrganization = creatorOrganization != ""
        ? creatorOrganization
        : (exists(creatorOrganizationPath)
          ? get(creatorOrganizationPath).data.get("organizationCode", "")
          : "");
      return organization != ""
        && normalizeOrganizationCode(verifiedCreatorOrganization) == normalizeOrganizationCode(organization)
        && (
          eventOrganizationMatches(eventData, organization)
          || (!eventHasOrganization(eventData)
            && creatorUid == request.auth.uid
            && eventOwner(eventData))
        );
    }

    function isEventOrganizerAccount() {
      let profile = currentAdminProfile();
      let organizationPath = /databases/$(database)/documents/eventOrganizations/$(request.auth.uid);
      return exists(organizationPath)
        || profileHasRole(profile, ["eventorganizer", "organizer", "eo", "Event Organizer"]);
    }

    function organizerOrganizationMatches(eventData) {
      let organizationPath = /databases/$(database)/documents/eventOrganizations/$(request.auth.uid);
      let profile = currentAdminProfile();
      let profileOrganization = profile.get(
        "organizationCode", profile.get("orgCode", profile.get("organization", ""))
      );
      let organization = profileOrganization != ""
        ? profileOrganization
        : (exists(organizationPath)
          ? get(organizationPath).data.get("organizationCode", "")
          : "");
      return organization != ""
        && eventOrganizationMatches(eventData, organization);
    }

    function eventOwnerOrganizationMatches(eventData) {
      let organizationPath = /databases/$(database)/documents/eventOrganizations/$(request.auth.uid);
      let profile = currentAdminProfile();
      let profileOrganization = profile.get(
        "organizationCode", profile.get("orgCode", profile.get("organization", ""))
      );
      let organization = profileOrganization != ""
        ? profileOrganization
        : (exists(organizationPath)
          ? get(organizationPath).data.get("organizationCode", "")
          : "");
      return !isEventOrganizerAccount()
        || (organization != "" && organization != "*"
          && (
            eventOrganizationMatches(eventData, organization)
            || (!eventHasOrganization(eventData) && eventOwner(eventData))
          ));
    }

    function eventOwner(eventData) {
      return eventData.get("organizerUid", "") == request.auth.uid
        || eventData.get("organizerId", "") == request.auth.uid
        || eventData.get("createdBy", "") == request.auth.uid;
    }

    function eventIsPublished(eventData) {
      return eventData.get("status", "") in [
          "approved", "Approved", "APPROVED", "published", "Published", "PUBLISHED",
          "completed", "Completed", "COMPLETED", "rescheduled", "Rescheduled", "RESCHEDULED",
          "cancelled", "Cancelled", "CANCELLED", "canceled", "Canceled"
        ]
        || eventData.get("publicationStatus", "") in ["published", "Published", "PUBLISHED"]
        || eventData.get("published", false) == true
        || eventData.get("isPublished", false) == true;
    }

    function canReadEvent(eventData) {
      return signedIn() && (
        isSuperAdminAccount()
        || (isOrganizationAdviser()
          ? adviserOrganizationMatches(eventData)
          : (eventIsPublished(eventData)
            || (isEventOrganizerAccount()
              ? (eventOwner(eventData) || organizerOrganizationMatches(eventData))
              : (isAdminAccount() || eventOwner(eventData)))))
      );
    }

    function canManageEvent(eventData) {
      return signedIn() && (
        (isOrganizationAdviser()
          ? adviserOrganizationMatches(eventData)
          : (eventOwner(eventData) || isAdminAccount()))
      );
    }

    function isStaffAccount() {
      let profile = currentAdminProfile();
      return signedIn()
        && (
          isAdminAccount()
          || isEventOrganizerAccount()
          || profileHasRole(profile, [
            "teacher", "faculty", "adviser", "advisor", "orgadv", "hap", "osas",
            "labhead", "qaccoordinator", "propertycustodian", "administrativeofficer",
            "Teacher", "Faculty", "Adviser", "Advisor"
          ])
        );
    }

    function canReadManagedEventRegistrations(eventId) {
      let eventPath = /databases/$(database)/documents/events/$(eventId);
      return isStaffAccount()
        && exists(eventPath)
        && canManageEvent(get(eventPath).data);
    }

    match /users/{userId} {
      allow read: if true;
      allow write: if signedIn();
    }

    match /adminUser/{userId} {
      function validOwnProfileUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly([
            "firstName", "middleName", "lastName", "fullName", "name",
            "contactNumber", "contact", "email", "pendingEmail"
          ])
          && (!changed.hasAny(["firstName"])
            || (request.resource.data.get("firstName", "") is string
              && request.resource.data.get("firstName", "").size() > 0
              && request.resource.data.get("firstName", "").size() <= 100))
          && (!changed.hasAny(["middleName"])
            || (request.resource.data.get("middleName", "") is string
              && request.resource.data.get("middleName", "").size() <= 100))
          && (!changed.hasAny(["lastName"])
            || (request.resource.data.get("lastName", "") is string
              && request.resource.data.get("lastName", "").size() > 0
              && request.resource.data.get("lastName", "").size() <= 100))
          && (!changed.hasAny(["fullName"])
            || (request.resource.data.get("fullName", "") is string
              && request.resource.data.get("fullName", "").size() > 0
              && request.resource.data.get("fullName", "").size() <= 302))
          && (!changed.hasAny(["name"])
            || (request.resource.data.get("name", "") is string
              && request.resource.data.get("name", "").size() > 0
              && request.resource.data.get("name", "").size() <= 302))
          && (!changed.hasAny(["contactNumber"])
            || (request.resource.data.get("contactNumber", "") is string
              && request.resource.data.get("contactNumber", "").matches("^09[0-9]{9}$")))
          && (!changed.hasAny(["contact"])
            || (request.resource.data.get("contact", "") is string
              && request.resource.data.get("contact", "").matches("^09[0-9]{9}$")))
          && (!changed.hasAny(["email"])
            || (request.resource.data.get("email", "") is string
              && request.resource.data.get("email", "").size() > 0
              && request.resource.data.get("email", "").size() <= 254))
          && (!changed.hasAny(["pendingEmail"])
            || (request.resource.data.get("pendingEmail", "") is string
              && request.resource.data.get("pendingEmail", "").size() <= 254));
      }
      function validOsasOwnAdminDetailsUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return changed.hasOnly([
            "position", "campus", "department", "designation",
            "organization", "adminId", "updatedAt"
          ])
          && changed.hasAny([
            "position", "campus", "department", "designation",
            "organization", "adminId"
          ])
          && (!changed.hasAny(["position"])
            || (request.resource.data.get("position", "") is string
              && request.resource.data.get("position", "").size() > 0
              && request.resource.data.get("position", "").size() <= 150))
          && (!changed.hasAny(["campus"])
            || (request.resource.data.get("campus", "") is string
              && request.resource.data.get("campus", "").size() > 0
              && request.resource.data.get("campus", "").size() <= 150))
          && (!changed.hasAny(["department"])
            || (request.resource.data.get("department", "") is string
              && request.resource.data.get("department", "").size() <= 150))
          && (!changed.hasAny(["designation"])
            || (request.resource.data.get("designation", "") is string
              && request.resource.data.get("designation", "").size() <= 150))
          && (!changed.hasAny(["organization"])
            || (request.resource.data.get("organization", "") is string
              && request.resource.data.get("organization", "").size() <= 200))
          && (!changed.hasAny(["adminId"])
            || (request.resource.data.get("adminId", "") is string
              && request.resource.data.get("adminId", "").size() > 0
              && request.resource.data.get("adminId", "").size() <= 100))
          && (!changed.hasAny(["updatedAt"])
            || request.resource.data.get("updatedAt", null) is timestamp);
      }
      allow read: if signedIn();
      allow create, update, delete: if signedIn()
        && isSuperAdminAccount();
      allow update: if signedIn()
        && request.auth.uid == userId
        && (
          validOwnProfileUpdate()
          || (isOsasAccount() && validOsasOwnAdminDetailsUpdate())
        );
    }

    match /approverOrganizations/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /eventOrganizations/{userId} {
      function validOrganizerProfileMap(before, after) {
        let changed = after.diff(before).affectedKeys();
        return changed.hasOnly([
            "firstName", "middleName", "lastName", "fullName", "name",
            "contactNumber", "email", "pendingEmail"
          ])
          && (!changed.hasAny(["firstName"])
            || (after.get("firstName", "") is string
              && after.get("firstName", "").size() > 0
              && after.get("firstName", "").size() <= 100))
          && (!changed.hasAny(["middleName"])
            || (after.get("middleName", "") is string
              && after.get("middleName", "").size() <= 100))
          && (!changed.hasAny(["lastName"])
            || (after.get("lastName", "") is string
              && after.get("lastName", "").size() > 0
              && after.get("lastName", "").size() <= 100))
          && (!changed.hasAny(["fullName"])
            || (after.get("fullName", "") is string
              && after.get("fullName", "").size() > 0
              && after.get("fullName", "").size() <= 302))
          && (!changed.hasAny(["name"])
            || (after.get("name", "") is string
              && after.get("name", "").size() > 0
              && after.get("name", "").size() <= 302))
          && (!changed.hasAny(["contactNumber"])
            || (after.get("contactNumber", "") is string
              && after.get("contactNumber", "").matches("^09[0-9]{9}$")))
          && (!changed.hasAny(["email"])
            || (after.get("email", "") is string
              && request.auth.token.email_verified == true
              && after.get("email", "") == request.auth.token.email
              && after.get("email", "").size() > 0
              && after.get("email", "").size() <= 254))
          && (!changed.hasAny(["pendingEmail"])
            || (after.get("pendingEmail", "") is string
              && after.get("pendingEmail", "").size() <= 254));
      }

      function validOwnOrganizerProfileUpdate() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return validOrganizerProfileMap(resource.data, request.resource.data)
          || (
            changed.hasOnly(["profile"])
            && validOrganizerProfileMap(
              resource.data.get("profile", {}),
              request.resource.data.get("profile", {})
            )
          )
          || (
            changed.hasOnly(["userProfile"])
            && validOrganizerProfileMap(
              resource.data.get("userProfile", {}),
              request.resource.data.get("userProfile", {})
            )
          )
          || (
            changed.hasOnly(["organizerProfile"])
            && validOrganizerProfileMap(
              resource.data.get("organizerProfile", {}),
              request.resource.data.get("organizerProfile", {})
            )
          );
      }

      allow read: if signedIn() && request.auth.uid == userId;
      allow create, delete: if false;
      allow update: if signedIn()
        && request.auth.uid == userId
        && validOwnOrganizerProfileUpdate();
    }

    match /system_settings/{settingsId} {
      allow read: if signedIn()
        && (
          isAdminAccount()
          || isEventOrganizerAccount()
          || profileHasRole(currentAdminProfile(), ["teacher", "faculty", "Teacher", "Faculty"])
        );
      allow create, update, delete: if signedIn() && isSuperAdminAccount();
    }

    match /notifications/{notificationId} {
      function matchesStudentRecipient(recipient) {
        let profilePath = /databases/$(database)/documents/users/$(request.auth.uid);
        let profile = exists(profilePath) ? get(profilePath).data : {};
        let studentId = profile.get("studentId", "");
        let studentNumber = profile.get("studentNumber", "");
        let studentNo = profile.get("studentNo", "");
        return recipient is string
          && recipient != ""
          && (
            (studentId != "" && recipient == studentId)
            || (studentNumber != "" && recipient == studentNumber)
            || (studentNo != "" && recipient == studentNo)
          );
      }

      function isRecipient() {
        let recipientUid = resource.data.get("recipientUid", "");
        let recipientUserId = resource.data.get("recipientUserId", "");
        let recipientId = resource.data.get("recipientId", "");
        let userId = resource.data.get("userId", "");
        let organizerUid = resource.data.get("organizerUid", "");
        let organizerId = resource.data.get("organizerId", "");
        return signedIn() && (
          recipientUid == request.auth.uid
          || matchesStudentRecipient(recipientUid)
          || recipientUserId == request.auth.uid
          || matchesStudentRecipient(recipientUserId)
          || recipientId == request.auth.uid
          || matchesStudentRecipient(recipientId)
          || userId == request.auth.uid
          || matchesStudentRecipient(userId)
          || organizerUid == request.auth.uid
          || matchesStudentRecipient(organizerUid)
          || organizerId == request.auth.uid
          || matchesStudentRecipient(organizerId)
        );
      }

      function isAdminNotification() {
        return signedIn()
          && isAdminAccount()
          && resource.data.get("recipientRole", "") == "admin";
      }

      function canManageNotification() {
        return isRecipient() || isAdminNotification();
      }

      allow read: if canManageNotification();
      allow create: if signedIn()
        && (isStaffAccount()
          || request.resource.data.get("userId", "") == request.auth.uid);
      allow update: if canManageNotification()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["read", "readAt", "deletedAt"])
        && request.resource.data.get("read", false) is bool
        && (
          request.resource.data.get("readAt", null) == null
          || request.resource.data.get("readAt", null) is timestamp
        )
        && (
          request.resource.data.get("deletedAt", null) == null
          || request.resource.data.get("deletedAt", null) is timestamp
        );
      allow delete: if canManageNotification();
    }

    match /events/{eventId} {
      allow read: if canReadEvent(resource.data);

      allow create: if canManageEvent(request.resource.data)
        && (
          isOrganizationAdviser()
          || eventOwnerOrganizationMatches(request.resource.data)
        );

      allow update: if (
          canManageEvent(resource.data)
          && canManageEvent(request.resource.data)
          && (
            isOrganizationAdviser()
            || eventOwnerOrganizationMatches(request.resource.data)
          )
        );

      allow delete: if canManageEvent(resource.data)
        && (
          isOrganizationAdviser()
          || eventOwnerOrganizationMatches(resource.data)
        );

      match /registrations/{userId} {
        function eventIsPublished() {
          let event = get(/databases/$(database)/documents/events/$(eventId)).data;
          let status = event.get("status", "");
          let publicationStatus = event.get("publicationStatus", "");
          return status in ["published", "Published", "PUBLISHED"]
            || publicationStatus in ["published", "Published", "PUBLISHED"]
            || event.get("published", false) == true
            || event.get("isPublished", false) == true;
        }

        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || canReadManagedEventRegistrations(eventId)
          );

        allow create: if signedIn()
          && request.auth.uid == userId
          && eventIsPublished()
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.status == "registered";

        allow update: if signedIn()
          && request.auth.uid == userId
          && eventIsPublished()
          && resource.data.uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "uid", "status", "registeredAt", "cancelledAt", "at"
          ])
          && (
            (resource.data.status == "registered"
              && request.resource.data.status == "cancelled")
            || (resource.data.status == "cancelled"
              && request.resource.data.status == "registered")
          );

        allow delete: if false;
      }

      match /attendance/{userId} {
        function canManageAttendance() {
          let eventPath = /databases/$(database)/documents/events/$(eventId);
          return signedIn()
            && exists(eventPath)
            && canManageEvent(get(eventPath).data);
        }

        allow read: if signedIn()
          && (
            request.auth.uid == userId
            || canReadManagedEventRegistrations(eventId)
          );
        allow create, update: if canManageAttendance()
          && request.resource.data.uid == userId
          && request.resource.data.keys().hasAll([
            "uid", "scannedAt", "scannedBy", "walkIn", "name", "studentNo", "organization"
          ])
          && request.resource.data.keys().hasOnly([
            "uid", "scannedAt", "scannedBy", "walkIn", "name", "studentNo", "organization"
          ])
          && request.resource.data.scannedAt is number
          && request.resource.data.scannedBy is string
          && request.resource.data.walkIn is bool
          && request.resource.data.name is string
          && request.resource.data.studentNo is string
          && request.resource.data.organization is string;
        allow delete: if false;
      }
    }

    match /{path=**}/registrations/{registrationId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /{path=**}/attendance/{attendanceId} {
      allow read: if signedIn()
        && resource.data.uid == request.auth.uid;
    }

    match /audit_logs/{entryId} {
      allow read: if isSuperAdminAccount();
      allow create: if signedIn()
        && (isStaffAccount()
          || request.resource.data.get("userId", "") == request.auth.uid);
      allow update, delete: if false;
    }

    match /correctionRequests/{requestId} {
      allow create: if signedIn()
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.reason is string
        && request.resource.data.reason.size() >= 10
        && request.resource.data.reason.size() <= 500
        && request.resource.data.requestedValue is string
        && request.resource.data.requestedValue.size() >= 1
        && request.resource.data.requestedValue.size() <= 200;
      allow read: if signedIn()
        && (resource.data.get("requesterUid", "") == request.auth.uid
          || isAdminAccount()
          || isOsasAccount());
      allow update: if signedIn()
        && (isAdminAccount() || isOsasAccount())
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "status", "reviewedBy", "reviewedByName", "reviewedAt",
          "reviewNote", "updatedAt"
        ]);
      allow delete: if false;
    }

    // Login page reads this before sign-in (maintenance flag only)
    match /systemSettings/{settingsId} {
      allow read: if true;
      allow write: if isSuperAdminAccount();
    }
  }
}